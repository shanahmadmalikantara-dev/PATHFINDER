# Salin file ini menjadi ".env" lalu isi nilainya.

# Lokasi file database SQLite (folder akan dibuat otomatis)
DATABASE_PATH=./data/pathfinder.db

# (Opsional) API key Gemini dari https://aistudio.google.com/apikey
# Kalau dikosongkan, aplikasi tetap jalan memakai "AI simulasi" berbasis aturan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tampilkan tombol "Masuk sebagai akun demo" di halaman login (true/false)
DEMO_MODE=true

# Batas pemakaian Gemini per akun per hari (kalau habis, fitur memakai mode simulasi)
AI_LIMIT_CHAT=20
AI_LIMIT_PLAN=5
AI_LIMIT_GUIDE=10
# Akun tanpa batas, pisahkan dengan koma (mis. akun yang dipakai juri saat final)
AI_UNLIMITED_EMAILS=
